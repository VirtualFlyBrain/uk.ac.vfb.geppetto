<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
          http://maven.apache.org/xsd/settings-1.0.0.xsd">

  <!-- Mirror configuration to handle blocked Spring Source repositories -->
  <mirrors>
    <!-- Block Spring Source repositories and redirect to Maven Central -->
    <mirror>
      <id>springsource-bundles-release-mirror</id>
      <mirrorOf>com.springsource.repository.bundles.release</mirrorOf>
      <url>https://repo.maven.apache.org/maven2</url>
    </mirror>
    <mirror>
      <id>springsource-bundles-external-mirror</id>
      <mirrorOf>com.springsource.repository.bundles.external</mirrorOf>
      <url>https://repo.maven.apache.org/maven2</url>
    </mirror>
    <mirror>
      <id>springsource-libraries-release-mirror</id>
      <mirrorOf>com.springsource.repository.libraries.release</mirrorOf>
      <url>https://repo.maven.apache.org/maven2</url>
    </mirror>
    <mirror>
      <id>springsource-libraries-external-mirror</id>
      <mirrorOf>com.springsource.repository.libraries.external</mirrorOf>
      <url>https://repo.maven.apache.org/maven2</url>
    </mirror>
  </mirrors>
</settings>
