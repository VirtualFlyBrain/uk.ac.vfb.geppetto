<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
          http://maven.apache.org/xsd/settings-1.0.0.xsd">

  <!-- Mirror configuration to block inaccessible Spring Source repositories -->
  <mirrors>
    <!-- Block all Spring Source repositories to prevent resolution failures -->
    <mirror>
      <id>maven-central-blocker</id>
      <mirrorOf>com.springsource.repository.bundles.release,com.springsource.repository.bundles.external,com.springsource.repository.libraries.release,com.springsource.repository.libraries.external</mirrorOf>
      <url>file:///dev/null</url>
    </mirror>
  </mirrors>

  <!-- Repository configuration to provide fallback for Spring Source wrapped artifacts -->
  <repositories>
    <repository>
      <id>org.geppetto-mvn-repo</id>
      <url>https://raw.github.com/openworm/org.geppetto.maven/mvn-repo</url>
      <snapshots>
        <enabled>true</enabled>
        <updatePolicy>always</updatePolicy>
      </snapshots>
    </repository>
    <repository>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>

  <pluginRepositories>
    <pluginRepository>
      <id>org.geppetto-mvn-repo</id>
      <url>https://raw.github.com/openworm/org.geppetto.maven/mvn-repo</url>
      <snapshots>
        <enabled>true</enabled>
        <updatePolicy>always</updatePolicy>
      </snapshots>
    </pluginRepository>
    <pluginRepository>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </pluginRepository>
  </pluginRepositories>
</settings>
